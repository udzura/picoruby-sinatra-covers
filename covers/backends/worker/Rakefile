require "fileutils"
require "open3"
require_relative "../../lib/scenario_target"

BACKEND_ROOT = File.expand_path(__dir__)
PROJECT_ROOT = File.expand_path("../../..", BACKEND_ROOT)
PICORUBY_ROOT = ENV.fetch("PICORUBY_ROOT") do
  abort "Set PICORUBY_ROOT to a PicoRuby source checkout."
end
PICORUBY_RAKEFILE = File.join(PICORUBY_ROOT, "Rakefile")
BUILD_CONFIG = File.join(BACKEND_ROOT, "build_config", "picoruby-worker-wasm.rb")
DIST_DIR = File.join(BACKEND_ROOT, "dist")

abort "PicoRuby Rakefile was not found: #{PICORUBY_RAKEFILE}" unless File.file?(PICORUBY_RAKEFILE)

def verify_emscripten!
  expected = File.read(File.join(BACKEND_ROOT, ".emscripten-version")).strip
  output, status = Open3.capture2e("emcc", "--version")
  abort "emcc was not found. Activate emsdk #{expected} first." unless status.success?

  actual = output[/\bemcc .*?\s(\d+\.\d+\.\d+)\s\(/, 1]
  return if actual == expected

  abort "Emscripten #{expected} is required (found #{actual || "unknown"})."
rescue Errno::ENOENT
  abort "emcc was not found. Activate emsdk #{expected} first."
end

def build_runtime!
  verify_emscripten!
  environment = {
    "CONFIG" => BUILD_CONFIG,
    "PICORUBY_SINATRA_COVERS_GEM_DIR" => PROJECT_ROOT,
  }
  sh environment, "rake", "-f", PICORUBY_RAKEFILE
end

def mrbc_path
  mrbc = ENV.fetch(
    "PICORUBY_MRBC",
    File.join(PICORUBY_ROOT, "build", "mrbc", "default", "bin", "mrbc"),
  )
  abort "mrbc was not found: #{mrbc}" unless File.executable?(mrbc)
  mrbc
end

def compile_app!
  app_source = SinatraCovers::ScenarioTarget.from_environment.app_path
  mrbc = mrbc_path
  FileUtils.mkdir_p(DIST_DIR)
  sh mrbc, "-o", File.join(DIST_DIR, "app.bin"), app_source
end

def stage_runtime!
  runtime_dir = File.join(PICORUBY_ROOT, "build", "picoruby-worker-wasm", "bin")
  FileUtils.mkdir_p(DIST_DIR)
  %w[picoruby-worker.js picoruby-worker.wasm].each do |artifact|
    source = File.join(runtime_dir, artifact)
    abort "runtime artifact was not found: #{source}" unless File.file?(source)

    FileUtils.cp(source, DIST_DIR)
  end
end

desc "Build the Worker runtime and the Sinatra cover application"
task build: [:runtime, :app]

desc "Build and stage the Worker runtime without compiling an application"
task :runtime do
  build_runtime!
  stage_runtime!
end

desc "Check that the staged Worker runtime and mrbc are available"
task :check_runtime do
  mrbc_path
  %w[picoruby-worker.js picoruby-worker.wasm].each do |artifact|
    path = File.join(DIST_DIR, artifact)
    abort "Worker runtime artifact was not found: #{path}. Run `rake covers:worker:runtime` first." unless File.file?(path)
  end
end

desc "Compile the selected Sinatra cover application"
task :app do
  compile_app!
end

desc "Remove generated Worker artifacts"
task :clean do
  FileUtils.rm_rf(DIST_DIR)
end
